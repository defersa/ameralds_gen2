{
  "name": "@ameralds/am-back",
  "private": true,
  "scripts": {
    "typeorm": "ts-node -r tsconfig-paths/register ../../node_modules/typeorm/cli.js",
    "typeorm:migration:generate": "node --require ts-node/register ../../node_modules/typeorm/cli.js migration:generate -d database/options.mjs database/migrations/manual-migration",
    "typeorm:migration:run": "node --require ts-node/register ../../node_modules/typeorm/cli.js migration:run -d database/options.mjs",
    "typeorm:migration:revert": "node --require ts-node/register ../../node_modules/typeorm/cli.js migration:revert -d database/options.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/typeorm": "^11.0.3",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "date-fns": "^4.4.0",
    "helmet": "^8.3.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3",
    "tslib": "^2.8.1",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/supertest": "^7.2.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "webpack-cli": "^7.2.2"
  }
}
