{
    "name": "@ameralds/source",
    "version": "0.0.0",
    "license": "MIT",
    "scripts": {
        "am:start:dev": "bash tools/start-dev.sh",
        "am:back:start:dev": "cross-env NODE_ENV=dev npx nx run am-back:serve --watch --outputStyle=stream",
        "am:back:build": "npx nx run am-back:build",
        "am:back:start": "npx nx run am-back:serve --outputStyle=stream",
        "am:back:typeorm": "npm --workspace @ameralds/am-back run typeorm --",
        "am:back:typeorm:migration:generate": "npm --workspace @ameralds/am-back run typeorm:migration:generate",
        "am:back:typeorm:migration:run": "npm --workspace @ameralds/am-back run typeorm:migration:run",
        "am:back:typeorm:migration:revert": "npm --workspace @ameralds/am-back run typeorm:migration:revert",
        "am:front:start": "npx nx run am-front:serve --port=4400 --outputStyle=stream",
        "am:front:build": "npx nx run am-front:build",
        "am:front:test": "npx nx run am-front:test",
        "am:front:lint": "npx nx run am-front:lint",
        "am:front:generate:icons": "node apps/am-front/tools/generate-icon-map.js",
        "am:front:generate:api": "node apps/am-front/tools/api-generator.mjs",
        "am:bd:up": "sudo bash apps/am-bd/_up.sh",
        "am:bd:down": "sudo bash apps/am-bd/_down.sh"
    },
    "private": true,
    "workspaces": [
        "apps/am-front",
        "apps/am-back",
        "apps/am-back-e2e"
    ],
    "devDependencies": {
        "@eslint/js": "^9.8.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.1.0",
        "@typescript-eslint/eslint-plugin": "^8.38.0",
        "@typescript-eslint/parser": "^8.38.0",
        "cross-env": "^10.0.0",
        "eslint": "^9.32.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.3",
        "jest": "^30.0.5",
        "@nx/angular": "^21.3.11",
        "@nx/eslint": "21.3.11",
        "@nx/eslint-plugin": "21.3.11",
        "@nx/jest": "21.3.11",
        "@nx/js": "21.3.11",
        "@nx/nest": "21.3.11",
        "@nx/node": "21.3.11",
        "@nx/web": "21.3.11",
        "@nx/webpack": "21.3.11",
        "@nx/workspace": "21.3.11",
        "@swc-node/register": "~1.9.1",
        "@swc/core": "~1.5.7",
        "@swc/helpers": "~0.5.11",
        "@typescript-eslint/utils": "^8.29.0",
        "jest-util": "^30.0.2",
        "nx": "21.3.11",
        "prettier": "^3.6.2",
        "tslib": "^2.3.0",
        "typescript": "~5.8.2",
        "typescript-eslint": "^8.29.0",
        "webpack": "^5.109.2",
        "webpack-cli": "^7.2.2"
    }
}
