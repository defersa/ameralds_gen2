{
    "name": "@ameralds/source",
    "version": "0.0.0",
    "license": "MIT",
    "scripts": {
        "am:start:dev": "bash tools/start-dev.sh",
        "am:back:start:dev": "cross-env NODE_ENV=dev npx nx run am-back:serve --watch --outputStyle=stream",
        "am:back:build": "npx nx run am-back:build",
        "am:back:start": "npx nx run am-back:serve --outputStyle=stream",
        "am:back:typeorm": "npm --workspace @ameralds/am-back run typeorm --",
        "am:back:typeorm:migration:generate": "npm --workspace @ameralds/am-back run typeorm:migration:generate",
        "am:back:typeorm:migration:run": "npm --workspace @ameralds/am-back run typeorm:migration:run",
        "am:back:typeorm:migration:revert": "npm --workspace @ameralds/am-back run typeorm:migration:revert",
        "am:front:start": "npx nx run am-front:serve --port=4400 --outputStyle=stream",
        "am:front:build": "npx nx run am-front:build",
        "am:front:test": "npx nx run am-front:test",
        "am:front:lint": "npx nx run am-front:lint",
        "am:front:generate:icons": "node apps/am-front/tools/generate-icon-map.js",
        "am:front:generate:api": "npm --workspace @ameralds/am-front run am:front:generate:api:v2",
        "am:bd:up": "sudo bash apps/am-bd/_up.sh",
        "am:bd:down": "sudo bash apps/am-bd/_down.sh"
    },
    "private": true,
    "workspaces": [
        "apps/am-front",
        "apps/am-back",
        "apps/am-back-e2e"
    ],
    "devDependencies": {
        "@angular-devkit/core": "^22.0.9",
        "@angular-devkit/schematics": "^22.0.9",
        "@angular/build": "^22.0.9",
        "@angular/cli": "^22.0.9",
        "@angular/compiler": "^22.1.0",
        "@angular/compiler-cli": "^22.1.0",
        "@angular/core": "^22.1.0",
        "@eslint/js": "^9.8.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.1.0",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "@typescript-eslint/utils": "^8.65.0",
        "cross-env": "^10.0.0",
        "eslint": "^9.32.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.3",
        "jest": "^30.0.5",
        "@nx/angular": "^23.1.0",
        "@nx/eslint": "^23.1.0",
        "@nx/eslint-plugin": "^23.1.0",
        "@nx/jest": "^23.1.0",
        "@nx/js": "^23.1.0",
        "@nx/nest": "^23.1.0",
        "@nx/node": "^23.1.0",
        "@nx/web": "^23.1.0",
        "@nx/webpack": "^23.1.0",
        "@nx/workspace": "^23.1.0",
        "@schematics/angular": "^22.0.9",
        "@swc-node/register": "^1.12.1",
        "@swc/core": "^1.15.47",
        "@swc/helpers": "^0.5.23",
        "jest-util": "^30.0.2",
        "nx": "^23.1.0",
        "prettier": "^3.6.2",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.65.0",
        "webpack": "^5.109.2",
        "webpack-cli": "^7.2.2"
    }
}
