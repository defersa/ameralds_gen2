DB_DATABASE=ambase
DB_USERNAME=ambuser
DB_PASSWORD=ampassword
DB_PORT=6668
DB_HOST=localhost
NODE_ENV=dev
JWT_SECRET=dev-jwt-secret-change-me
SITE_URL=http://localhost:4400

# В dev используется Mailpit на 127.0.0.1:1025; для других окружений задайте SMTP.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Ameralds <no-reply@example.com>

# Trusted reverse proxy addresses/subnets, comma-separated; leave unset without a proxy.
# TRUST_PROXY=loopback

# Сверка платежей: cron работает раз в минуту, API возвращает только серверный статус.
# PAYMENT_RECONCILE_BATCH=50
# PAYMENT_RECHECK_SECONDS=5
# PAYMENT_TERMINAL_RECHECK_SECONDS=3600
# PAYMENT_TERMINAL_RECHECK_DAYS=7
# PAYMENT_STUCK_AFTER_HOURS=24
# Только dev/test: HMAC-SHA256 внешнего ID для mock webhook; без секрета webhook запрещён.
# PAYMENT_MOCK_WEBHOOK_SECRET=
